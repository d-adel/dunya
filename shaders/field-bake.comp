#version 450
#extension GL_GOOGLE_include_directive : require

#include "field-types.glsl"

// Set 0 here is the same descriptor set layout the fragment shader declares at
// set 2. A set can be bound at different indices by different pipelines as long
// as the layout at that index matches, so no placeholder sets are needed.
const int MAX_FIELD_VOLUMES = DUNYA_MAX_FIELD_VOLUMES;

layout(std430, set = 0, binding = 3) readonly buffer FieldScene {
  Primitive primitives[];
} scene;

layout(r32f,
       set = 0,
       binding = 4) uniform writeonly image3D distanceVolume[MAX_FIELD_VOLUMES];
layout(r8ui,
       set = 0,
       binding = 5)
  uniform writeonly uimage3D materialVolume[MAX_FIELD_VOLUMES];

layout(push_constant) uniform BakeParams {
  vec4 origin;
  vec4 voxelSize;
  uvec4 resolution;
  uvec4 volume;
} params;

#define FIELD_PRIMITIVE_AT(i) scene.primitives[params.volume.y + (i)]

#define FIELD_PRIMITIVE_COUNT params.resolution.w

#include "field-common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

void main() {
  uvec3 at = gl_GlobalInvocationID;

  // The dispatch is rounded up to whole workgroups, so the tail runs off the
  // end of the lattice and has to be discarded.
  if (any(greaterThanEqual(at, params.resolution.xyz))) {
    return;
  }

  // Lattice points, matching bake() in sampled.cc: a resolution of N spans N-1
  // cells, and index zero sits exactly on the grid origin.
  vec3 p = params.origin.xyz + params.voxelSize.xyz * vec3(at);

  vec2 field = sceneDistance(p);

  uint volume = params.volume.x;

  imageStore(distanceVolume[volume], ivec3(at), vec4(field.x, 0.0, 0.0, 0.0));
  imageStore(materialVolume[volume],
             ivec3(at),
             uvec4(uint(field.y + 0.5), 0u, 0u, 0u));
}
