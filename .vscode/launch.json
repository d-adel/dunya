    {
      "name": "Runtime",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "engine: build (dev)",
      "program": "${workspaceFolder}/build-dev/DunyaRuntime.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build-dev",
      "console": "integratedTerminal"
    }
