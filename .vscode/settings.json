{
  "files.associations": {
    "*.ih": "cpp",
    // Keeps every shader on one language id, so the [glsl] block below and the
    // shader-validator server apply to all of them. .glsl in particular is
    // claimed by Unity ShaderLab extensions if any are ever installed again.
    "*.glsl": "glsl",
    "*.frag": "glsl",
    "*.vert": "glsl",
    "*.comp": "glsl"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  // Dev builds use Ninja, in their own directory. Two reasons: Ninja emits a
  // compile_commands.json (the Visual Studio generator never does, whatever
  // CMAKE_EXPORT_COMPILE_COMMANDS says), which is what stops IntelliSense
  // inventing include paths; and it rebuilds this project faster than MSBuild.
  // The VS-generator tree in build/ stays as-is -- that is the path the README
  // documents and the one verification builds use.
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build-ninja",
  // Fallback for files the provider cannot place (a new .cc not yet in any
  // target, a header opened before the first configure). Harmless when the
  // provider does know the file -- the provider wins.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build-ninja/compile_commands.json",
  // The SDK include arrives from an imported target, so CMake marks it system
  // and MSVC spells it -external:I, which not every cpptools version parses as
  // an include path. Listing it plainly costs nothing and removes the doubt.
  // Only consulted when the provider has nothing to say about a file (before
  // the first configure of a build directory, or for a file not in a target).
  // FetchContent puts the dependencies under the build tree, so they have to
  // be listed here too or glm/glfw/stb resolve to nothing.
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src",
    "${env:VULKAN_SDK}/Include",
    "${workspaceFolder}/build-ninja/_deps/glm-src",
    "${workspaceFolder}/build-ninja/_deps/glfw-src/include",
    "${workspaceFolder}/build-ninja/_deps/stb-src",
    "${workspaceFolder}/build-ninja/_deps/tinyobjloader-src"
  ],
  // Shader language server (antaalt.shader-validator): semantic highlighting,
  // completion, signature help, symbols, and glslang validation inline. It is
  // the only GLSL server tried here that serves semantic tokens -- without them
  // a shader is coloured by the TextMate grammar alone, which knows keywords
  // and leaves every identifier the default colour.
  //
  // The DUNYA_ values are the same numbers CMake passes to glslc; without them
  // the server sees undeclared identifiers where the build sees constants. They
  // are duplicated here rather than derived, so a capacity change means editing
  // two files -- CMake stays the source of truth for what is compiled.
  "shader-validator.glsl.targetClient": "Vulkan1_3",
  "shader-validator.includes": [
    "${workspaceFolder}/shaders"
  ],
  "shader-validator.defines": {
    "DUNYA_MAX_PRIMITIVES": "128",
    "DUNYA_MAX_TEXTURES": "16",
    "DUNYA_MAX_SAMPLERS": "8",
    "DUNYA_MAX_MATERIALS": "64",
    "DUNYA_MAX_FIELD_OBJECTS": "64",
    "DUNYA_SAMPLER_LINEAR_REPEAT": "0",
    "DUNYA_SAMPLER_LINEAR_CLAMP": "1",
    "DUNYA_SAMPLER_NEAREST_CLAMP": "2"
  },
  // No inline code suggestions in this repo -- every line here is written by
  // hand on purpose, and ghost text works against that.
  "github.copilot.enable": {
    "*": false,
    "cpp": false,
    "c": false,
    "cmake": false,
    "glsl": false,
    "markdown": false,
    "plaintext": false
  },
  "github.copilot.editor.enableAutoCompletions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  // Provider-agnostic kill switch: stops inline ghost text from any source.
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  // Formatting: clang-format, configured in .clang-format at the repo root.
  // Binary is the one bundled with ms-vscode.cpptools (22.1.3) — nothing to
  // install, but a different clang-format version can format differently.
  "editor.formatOnSave": true,
  // "file" formats the whole document; "modifications" touches only the lines
  // you changed (needs git) if a bulk reformat would bury a milestone diff.
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // Formatting stays with clang-format so shaders and C++ obey one style; see
  // shaders/.clang-format for the one setting that makes GLSL parse as C++.
  "[glsl]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "editor.semanticHighlighting.enabled": true,
  // The 22.1.3 binary cpptools ships, not the LLVM 14 on PATH: 14 does not know
  // the Macros key and rejects shaders/.clang-format outright. Absolute because
  // this extension expands ${workspaceRoot} and nothing else -- ${userHome} is
  // passed through as literal text and the binary is then never found. Version
  // number in the path, so a cpptools update breaks this loudly.
  "clang-format.executable": "C:/Users/Dilan/.vscode/extensions/ms-vscode.cpptools-1.33.8-win32-x64/LLVM/bin/clang-format.exe",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "C_Cpp.autocompleteAddParentheses": false,
  // The 80-column limit from .clang-format, made visible while typing.
  "editor.rulers": [
    80
  ],
  "editor.wordWrap": "off",
  // Whitespace hygiene for the file types clang-format never sees
  // (CMakeLists.txt, .md, shaders).
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "trailing",
  "editor.guides.bracketPairs": "active",
  "files.exclude": {
    "**/.vs": true,
    "**/out": true
  }
}
