{
  "files.associations": {
    "*.ih": "cpp"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "glsllint.glslangValidatorArgs": [
    "--target-env",
    "vulkan1.4"
  ],
  // No inline code suggestions in this repo -- every line here is written by
  // hand on purpose, and ghost text works against that.
  "github.copilot.enable": {
    "*": false,
    "cpp": false,
    "c": false,
    "cmake": false,
    "glsl": false,
    "markdown": false,
    "plaintext": false
  },
  "github.copilot.editor.enableAutoCompletions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  // Provider-agnostic kill switch: stops inline ghost text from any source.
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  // Formatting: clang-format, configured in .clang-format at the repo root.
  // Binary is the one bundled with ms-vscode.cpptools (22.1.3) — nothing to
  // install, but a different clang-format version can format differently.
  "editor.formatOnSave": true,
  // "file" formats the whole document; "modifications" touches only the lines
  // you changed (needs git) if a bulk reformat would bury a milestone diff.
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "C_Cpp.autocompleteAddParentheses": false,
  // The 80-column limit from .clang-format, made visible while typing.
  "editor.rulers": [
    80
  ],
  "editor.wordWrap": "off",
  // Whitespace hygiene for the file types clang-format never sees
  // (CMakeLists.txt, .md, shaders).
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "trailing",
  "editor.guides.bracketPairs": "active",
  "files.exclude": {
    "**/.vs": true,
    "**/out": true
  }
}
