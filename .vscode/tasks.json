{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build dev",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    },
    {
      "label": "test dev",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "test release",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
