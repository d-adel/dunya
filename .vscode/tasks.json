{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "engine: build (dev)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "engine: build (release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    },
    {
      "label": "engine: configure (dev)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "engine: test (dev)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "engine: test (release)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "game: package (demo)",
      "type": "shell",
      "command": "${workspaceFolder}/build-dev/DunyaPackager.exe",
      "args": [
        "${workspaceFolder}/build-dev/DunyaPlayer.exe",
        "${workspaceFolder}/build-dev/projects/demo",
        "${workspaceFolder}/build-dev/builds/demo",
        "main",
        "golden",
        "wall-big",
        "rain"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["engine: build (dev)"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "editor: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/editor/Dunya.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    },
    {
      "label": "editor: clean",
      "type": "shell",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/editor/Dunya.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "all: build",
      "dependsOrder": "sequence",
      "dependsOn": ["engine: build (dev)", "editor: build"],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}