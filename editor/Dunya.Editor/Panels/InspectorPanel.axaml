<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dunya.Editor.Panels.InspectorPanel">
  <DockPanel Background="{DynamicResource EditorPanelBackground}">
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EditorBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
      <StackPanel Spacing="6">
        <TextBlock Name="Subject"
                   Text="nothing selected"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource EditorFontSizeSmall}"
                   FontFamily="{DynamicResource EditorMonoFont}"
                   Foreground="{DynamicResource EditorSubtleText}" />
      <StackPanel Name="Stepper"
                    Orientation="Horizontal"
                    Spacing="6"
                    IsVisible="False">
          <Button Name="Previous" Content="&#x25C0;" Padding="8,2" />
          <TextBlock Name="Which"
                     VerticalAlignment="Center"
                     MinWidth="130"
                     TextAlignment="Center"
                     FontSize="{DynamicResource EditorFontSizeSmall}"
                     FontFamily="{DynamicResource EditorMonoFont}" />
          <Button Name="Next" Content="&#x25B6;" Padding="8,2" />
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Padding="8">
      <StackPanel Name="Cards" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
