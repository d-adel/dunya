<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dunya.Editor.Panels.EntitiesPanel">
  <DockPanel Background="{DynamicResource EditorPanelBackground}">
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EditorBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Name="Filter" Width="150" PlaceholderText="filter" />
        <TextBlock Name="Count"
                   VerticalAlignment="Center"
                   Text="no world"
                   FontSize="{DynamicResource EditorFontSizeSmall}"
                   FontFamily="{DynamicResource EditorMonoFont}"
                   Foreground="{DynamicResource EditorSubtleText}" />
      </StackPanel>
    </Border>
    <TreeDataGrid Name="Entities" />
  </DockPanel>
</UserControl>
