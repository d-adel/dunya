<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <DunyaNativeDir Condition="'$(DunyaNativeDir)' == ''">$(MSBuildProjectDirectory)\..\..\build-dev\engine\capi</DunyaNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="TreeDataGrid" Version="12.0.0.6" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.1.0.6" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.1.0.6" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

  <Target Name="DunyaRequireNative" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DunyaNativeDir)\dunya_c.dll')" Text="dunya_c.dll was not found in $(DunyaNativeDir). Build the engine first (cmake --build --preset dev), or point DunyaNativeDir elsewhere with -p:DunyaNativeDir=..." />
  </Target>

  <ItemGroup>
    <None Include="$(DunyaNativeDir)\dunya_c.dll" Condition="Exists('$(DunyaNativeDir)\dunya_c.dll')">
      <Link>dunya_c.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(DunyaNativeDir)\dunya_c.pdb" Condition="Exists('$(DunyaNativeDir)\dunya_c.pdb')">
      <Link>dunya_c.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
