<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="EditorSpaceXs">2</x:Double>
  <x:Double x:Key="EditorSpaceS">4</x:Double>
  <x:Double x:Key="EditorSpaceM">6</x:Double>
  <x:Double x:Key="EditorSpaceL">8</x:Double>
  <x:Double x:Key="EditorSpaceXl">12</x:Double>

  <x:Double x:Key="EditorRowHeight">22</x:Double>
  <x:Double x:Key="EditorLabelWidth">92</x:Double>

  <x:Double x:Key="EditorFontSize">12</x:Double>
  <x:Double x:Key="EditorFontSizeSmall">11</x:Double>

  <FontFamily x:Key="EditorMonoFont">Consolas,Cascadia Mono,monospace</FontFamily>

  <CornerRadius x:Key="EditorCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="EditorFieldCornerRadius">2</CornerRadius>

  <Thickness x:Key="EditorPanelPadding">8</Thickness>
  <Thickness x:Key="EditorCardPadding">8,6</Thickness>
  <Thickness x:Key="EditorCardHeaderPadding">6,5</Thickness>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="EditorWindowBackground" Color="#17171A" />
      <SolidColorBrush x:Key="EditorPanelBackground" Color="#1C1C1F" />
      <SolidColorBrush x:Key="EditorCardBackground" Color="#232327" />
      <SolidColorBrush x:Key="EditorCardHeaderBackground" Color="#2A2A30" />
      <SolidColorBrush x:Key="EditorFieldBackground" Color="#18181B" />
      <SolidColorBrush x:Key="EditorBorder" Color="#34343A" />
      <SolidColorBrush x:Key="EditorText" Color="#E4E4E7" />
      <SolidColorBrush x:Key="EditorSubtleText" Color="#8E8E96" />
      <SolidColorBrush x:Key="EditorAccent" Color="#4C8DF6" />
      <SolidColorBrush x:Key="EditorAxisX" Color="#E5484D" />
      <SolidColorBrush x:Key="EditorAxisY" Color="#4CC38A" />
      <SolidColorBrush x:Key="EditorAxisZ" Color="#5B8DEF" />
      <SolidColorBrush x:Key="EditorAxisW" Color="#A78BFA" />
      <Color x:Key="SystemListLowColor">#1AFFFFFF</Color>
      <Color x:Key="SystemListMediumColor">#26FFFFFF</Color>
      <Color x:Key="SystemAccentColor">#4C8DF6</Color>
      <Color x:Key="SystemAccentColorLight1">#6FA6F8</Color>
      <Color x:Key="SystemAccentColorDark1">#3673D4</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="EditorWindowBackground" Color="#F4F4F5" />
      <SolidColorBrush x:Key="EditorPanelBackground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="EditorCardBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="EditorCardHeaderBackground" Color="#F0F0F2" />
      <SolidColorBrush x:Key="EditorFieldBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="EditorBorder" Color="#D8D8DC" />
      <SolidColorBrush x:Key="EditorText" Color="#1F1F23" />
      <SolidColorBrush x:Key="EditorSubtleText" Color="#6E6E76" />
      <SolidColorBrush x:Key="EditorAccent" Color="#2563EB" />
      <SolidColorBrush x:Key="EditorAxisX" Color="#C62A2F" />
      <SolidColorBrush x:Key="EditorAxisY" Color="#2F8F5B" />
      <SolidColorBrush x:Key="EditorAxisZ" Color="#3557C4" />
      <SolidColorBrush x:Key="EditorAxisW" Color="#7C5BD6" />
      <Color x:Key="SystemListLowColor">#12000000</Color>
      <Color x:Key="SystemListMediumColor">#1F000000</Color>
      <Color x:Key="SystemAccentColor">#2563EB</Color>
      <Color x:Key="SystemAccentColorLight1">#4F86F0</Color>
      <Color x:Key="SystemAccentColorDark1">#1D4FBF</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
