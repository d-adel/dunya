<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dc="using:Dock.Avalonia.Controls"
        x:Class="Dunya.Editor.MainWindow"
        Title="dunya editor"
        Background="{DynamicResource EditorWindowBackground}"
        Width="1280" Height="800">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Window">
        <MenuItem Name="ResetLayoutItem" Header="_Reset Layout" />
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="_Open Project..." />
        <MenuItem Header="_Save World" />
        <Separator />
        <MenuItem Header="E_xit" />
      </MenuItem>

    </Menu>

    <dc:DockControl Name="Dock" />
  </DockPanel>
</Window>
